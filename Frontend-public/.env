# URL del backend para el proxy de desarrollo (por defecto http://localhost:4000).
BACKEND_URL=http://localhost:4000

# URL pública del backend. Déjala vacía en desarrollo: Vite redirige /api y /uploads a BACKEND_URL.
# En producción, apunta al dominio del backend, por ejemplo: https://api.proyectadas.com
VITE_API_URL=

# Correo de soporte que se muestra en /soporte (opcional). Ejemplo: soporte@tudominio.com
VITE_CORREO_SOPORTE=proyector.admin@gmail.com
