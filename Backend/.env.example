# Copia este archivo como .env y ajusta los valores.

# Servidor
PORT=4000
NODE_ENV=development

# Base de datos (MongoDB local)
MONGO_URI=mongodb://127.0.0.1:27017/proyectadas

# Autenticación (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# Zona horaria usada para reiniciar las oportunidades cada 1° de mes
APP_TIMEZONE=America/El_Salvador

# Tamaño máximo de cada video en MB
MAX_VIDEO_MB=100

# Dirección del frontend, para los enlaces de los correos (por defecto, el primer CORS_ORIGIN)
FRONTEND_URL=http://localhost:5173

# Correo saliente: recuperar la contraseña y avisos de la cuenta.
# Sin SMTP_HOST, los correos no se envían: se escriben en backend-local.log (útil para probar).
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=tu correo y
# SMTP_PASS=una "contraseña de aplicación" (se crea en tu cuenta de Google con la verificación en 2 pasos).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remitente que verán (por defecto: PROYECTADAS <SMTP_USER>)
CORREO_REMITENTE=

# Cuentas administradoras, por nombre de usuario (separados por coma): entran al panel de moderación,
# no se pueden suspender y tienen la insignia Gran Maestro permanente. Registra la cuenta antes de
# agregarla aquí: los nombres de esta lista ya no se pueden registrar.
ADMINS=

# Videos, portadas y fotos de perfil en Cloudinary (opcional). Copia la "API environment variable"
# de tu panel de Cloudinary. Sin esto se guardan en Backend/uploads/.
# Para mover a la nube los archivos que ya existen: npm run nube:migrar
CLOUDINARY_URL=
CLOUDINARY_CARPETA=proyectadas

# Límites anti-spam por usuario
LIMITE_SUBIDAS_POR_HORA=20
LIMITE_COMENTARIOS_POR_10_MIN=30
