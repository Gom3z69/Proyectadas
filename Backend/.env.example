# Copia este archivo como .env y ajusta los valores.

# Servidor
PORT=4000
NODE_ENV=development

# Base de datos (MongoDB local)
MONGO_URI=mongodb://127.0.0.1:27017/proyectadas

# Autenticación (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# Zona horaria usada para reiniciar las oportunidades cada 1° de mes
APP_TIMEZONE=America/El_Salvador

# Tamaño máximo de cada video en MB
MAX_VIDEO_MB=100
